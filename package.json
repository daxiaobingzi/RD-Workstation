{
  "name": "rw-station",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "弱电智能化设计工作台（Vue 3 重构版 · 纯本地存储）",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:desktop": "vite build --config vite.desktop.config.js",
    "app": "electron .",
    "dist:desktop": "npm run build:desktop && electron-builder"
  },
  "dependencies": {
    "pinia": "^2.3.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^1.3.0"
  },
  "build": {
    "appId": "com.rwstation.desktop",
    "productName": "我的工作台",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "dist-desktop/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "dist-desktop/app-icons/icon-512.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "dist-desktop/app-icons/icon-512.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "dist-desktop/app-icons/icon-512.png",
      "category": "public.app-category.productivity"
    }
  }
}
